<Window x:Class="BankAppWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BankApp Login"
        Height="520"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Border Width="350"
                Padding="30"
                Background="White"
                CornerRadius="14"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="BankApp"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#075889"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Operations Portal"
                           FontSize="15"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,30"/>

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="EmailTextBox"
                         Height="40"
                         Padding="10,8"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="40"
                             Padding="10,8"
                             Margin="0,0,0,12"/>

                <TextBlock x:Name="LoginMessage"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,10"/>

                <Button x:Name="LoginButton"
                        Content="Sign In"
                        Height="42"
                        Background="#075889"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Click="LoginButton_Click"/>

                <Button Content="Forgot Password?"
                        Height="34"
                        Background="Transparent"
                        Foreground="#075889"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ForgotPasswordButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

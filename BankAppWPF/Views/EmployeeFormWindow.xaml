<Window x:Class="BankAppWPF.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee"
        Height="760"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Border Margin="24" Padding="26" Background="White" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FormTitle"
                           Text="Employee"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#17233C"/>
                <TextBlock x:Name="FormSubtitle"
                           Foreground="#64748B"
                           Margin="0,5,0,24"/>

                <TextBlock Text="First Name" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="FirstNameTextBox" Height="38"
                         Padding="9,7" Margin="0,0,0,14"/>

                <TextBlock Text="Last Name" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="LastNameTextBox" Height="38"
                         Padding="9,7" Margin="0,0,0,14"/>

                <TextBlock Text="Email" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="EmailTextBox" Height="38"
                         Padding="9,7" Margin="0,0,0,14"/>

                <TextBlock Text="Phone" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="PhoneTextBox" Height="38"
                         Padding="9,7" Margin="0,0,0,14"/>

                <TextBlock Text="Branch" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="BranchComboBox" Height="38"
                          Padding="9,7"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="BranchId"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          IsTextSearchCaseSensitive="False"
                          StaysOpenOnEdit="True"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Role" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="RoleComboBox" Height="38"
                          Padding="9,7"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="RoleId"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          IsTextSearchCaseSensitive="False"
                          StaysOpenOnEdit="True"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Authorization Role"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="AuthRoleComboBox"
                          Height="38"
                          Padding="9,7"
                          Margin="0,0,0,14"/>

                <TextBlock x:Name="PasswordLabel"
                           Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordInput"
                             Height="38"
                             Padding="9,7"
                             Margin="0,0,0,12"/>

                <TextBlock x:Name="StatusMessage"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Height="40"
                            Margin="0,0,6,0"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Grid.Column="1"
                            Content="Save" Height="40"
                            Margin="6,0,0,0"
                            Background="#075889"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

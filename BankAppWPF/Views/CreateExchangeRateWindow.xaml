<Window x:Class="BankAppWPF.Views.CreateExchangeRateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Exchange Rate"
        Height="500"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Border Margin="24" Padding="26" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Create Exchange Rate"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#17233C"/>
            <TextBlock Text="Enter the latest currency-rate information."
                       Foreground="#64748B"
                       Margin="0,5,0,24"/>

            <TextBlock Text="Currency"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="CurrencyComboBox"
                      Height="38"
                      Padding="9,7"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="CurrencyCode"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      IsTextSearchCaseSensitive="False"
                      StaysOpenOnEdit="True"
                      Margin="0,0,0,14"/>

            <TextBlock Text="Rate"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="RateTextBox"
                     Height="38"
                     Padding="9,7"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Source"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="SourceTextBox"
                     Height="38"
                     Padding="9,7"
                     Margin="0,0,0,14"/>

            <TextBlock x:Name="StatusMessage"
                       Foreground="#C0392B"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Height="40"
                        Margin="0,0,6,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Content="Create"
                        Height="40"
                        Margin="6,0,0,0"
                        Background="#075889"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

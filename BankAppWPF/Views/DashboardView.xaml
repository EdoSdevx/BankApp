<UserControl x:Class="BankAppWPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="81.309"/>
            <RowDefinition Height="31.875"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusMessage"
                   Grid.Row="0"
                   Text="Loading dashboard..."
                   Foreground="#64748B"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <UniformGrid Grid.Row="1"
                     Columns="3" Grid.RowSpan="2">

            <Border Background="#EFF6FF"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Customers"
                               Foreground="#475569"
                               FontSize="14"/>
                    <TextBlock x:Name="CustomerCountText"
                               Text="—"
                               Foreground="#075889"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F0FDF4"
                    CornerRadius="10"
                    Padding="22"
                    Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Employees"
                               Foreground="#475569"
                               FontSize="14"/>
                    <TextBlock x:Name="EmployeeCountText"
                               Text="—"
                               Foreground="#15803D"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FFF7ED"
                    CornerRadius="10"
                    Padding="22"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Exchange Rates"
                               Foreground="#475569"
                               FontSize="14"/>
                    <TextBlock x:Name="ExchangeRateCountText"
                               Text="—"
                               Foreground="#C2410C"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>

<Window x:Class="BankAppWPF.Views.AccountFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account"
        Height="650"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Border Margin="24"
            Padding="26"
            Background="White"
            CornerRadius="12">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FormTitle"
                           Text="Account"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#17233C"/>

                <TextBlock x:Name="FormSubtitle"
                           Foreground="#64748B"
                           Margin="0,5,0,24"/>

                <TextBlock Text="Customer"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="CustomerComboBox"
                          Height="38"
                          Padding="9,7"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="CustomerId"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          IsTextSearchCaseSensitive="False"
                          StaysOpenOnEdit="True"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Branch"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="BranchComboBox"
                          Height="38"
                          Padding="9,7"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="BranchId"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          IsTextSearchCaseSensitive="False"
                          StaysOpenOnEdit="True"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Currency Code"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="CurrencyCodeTextBox"
                         Height="38"
                         Padding="9,7"
                         MaxLength="3"
                         CharacterCasing="Upper"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Balance"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="BalanceTextBox"
                         Height="38"
                         Padding="9,7"
                         Margin="0,0,0,6"/>

                <TextBlock x:Name="BalanceHint"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,0,0,14"/>

                <TextBlock x:Name="StatusMessage"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Cancel"
                            Height="40"
                            Margin="0,0,6,0"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SaveButton"
                            Grid.Column="1"
                            Content="Save"
                            Height="40"
                            Margin="6,0,0,0"
                            Background="#075889"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

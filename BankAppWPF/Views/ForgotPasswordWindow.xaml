<Window x:Class="BankAppWPF.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        Height="410"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Border Margin="24" Padding="28" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Forgot Password"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#17233C"/>

            <TextBlock Text="Enter your account email. If it exists, BankApp will send a password-reset link."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,6,0,24"/>

            <TextBlock Text="Email"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="EmailTextBox"
                     Height="40"
                     Padding="10,8"
                     Margin="0,0,0,12"/>

            <TextBlock x:Name="StatusMessage"
                       Foreground="#C0392B"
                       TextWrapping="Wrap"
                       MinHeight="42"
                       Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Height="40"
                        Margin="0,0,6,0"
                        Click="BackButton_Click"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send Reset Link"
                        Height="40"
                        Margin="6,0,0,0"
                        Background="#075889"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SendButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="BankAppWPF.Views.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Details"
        Height="600"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Border Margin="24" Padding="26" Background="White" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Customer Details"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#17233C"/>
                    <TextBlock x:Name="CustomerIdText"
                               Foreground="#64748B"
                               Margin="0,5,0,24"/>

                    <TextBlock Text="Full Name" Foreground="#64748B"/>
                    <TextBlock x:Name="FullNameText"
                               FontSize="17" Margin="0,4,0,16"/>

                    <TextBlock Text="Email" Foreground="#64748B"/>
                    <TextBlock x:Name="EmailText"
                               FontSize="17" Margin="0,4,0,16"/>

                    <TextBlock Text="Phone" Foreground="#64748B"/>
                    <TextBlock x:Name="PhoneText"
                               FontSize="17" Margin="0,4,0,16"/>

                    <TextBlock Text="Address" Foreground="#64748B"/>
                    <TextBlock x:Name="AddressText"
                               FontSize="17"
                               TextWrapping="Wrap"
                               Margin="0,4,0,16"/>

                    <TextBlock Text="Created" Foreground="#64748B"/>
                    <TextBlock x:Name="CreatedDateText"
                               FontSize="17" Margin="0,4,0,16"/>

                    <TextBlock Text="Status" Foreground="#64748B"/>
                    <TextBlock x:Name="ActiveStatusText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,4,0,16"/>

                    <TextBlock x:Name="StatusMessage"
                               Foreground="#C0392B"
                               TextWrapping="Wrap"
                               MinHeight="20"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1"
                    Content="Close"
                    Height="40"
                    Margin="0,16,0,0"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>

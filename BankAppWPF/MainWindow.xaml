<Window x:Class="BankAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BankApp"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F7FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#075889" Offset="0"/>
                    <GradientStop Color="#197AAE" Offset="0.45"/>
                    <GradientStop Color="#67C1E8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="20">
                <TextBlock Text="BankApp"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,10,0,35"/>

                <Button Content="Dashboard"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="DashboardButton_Click"/>

                <Button Content="Customers"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="CustomersButton_Click"/>

                <Button Content="Accounts"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="AccountsButton_Click"/>

                <Button Content="Employees"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="EmployeesButton_Click"/>

                <Button Content="Exchange Rates"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="ExchangeRatesButton_Click"/>

                <Button Content="Bills"
                        Height="45"
                        Click="BillsButton_Click"/>

                <Button Content="Logout"
                        Height="45"
                        Margin="0,30,0,0"
                        Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle"
                           Grid.Row="0"
                           Text="Dashboard"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#17233C"/>

                <TextBlock x:Name="PageSubtitle"
                           Grid.Row="1"
                           Text="Welcome to BankApp Operations"
                           FontSize="16"
                           Foreground="#64748B"
                           Margin="0,8,0,30"/>

                <Border Background="White"
                        Grid.Row="2"
                        CornerRadius="10"
                        Padding="25">
                    <ContentControl x:Name="PageContent"
                                    Content="Dashboard content will appear here."/>
                </Border>
        </Grid>
    </Grid>
</Window>
